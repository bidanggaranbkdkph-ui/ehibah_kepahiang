APP_NAME="E-Hibah Kepahiang"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ehibah.kepahiangkab.go.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# ---- PostgreSQL ----
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ehibah
DB_USERNAME=ehibah
DB_PASSWORD=
DB_SSLMODE=prefer

# ---- Sesi & keamanan ----
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
BCRYPT_ROUNDS=12
# Isi bila aplikasi berada di belakang reverse proxy / load balancer (daftar IP, pisahkan koma)
TRUSTED_PROXIES=

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# ---- Surel (notifikasi) ----
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="ehibah@kepahiangkab.go.id"
MAIL_FROM_NAME="${APP_NAME}"

# ---- E-Hibah ----
# Antivirus unggahan: none | clamscan (ClamAV terpasang di server)
EHIBAH_ANTIVIRUS=none
EHIBAH_CLAMSCAN=clamscan
# Lokasi backup (HARUS di luar webroot; salin berkala ke lokasi terpisah)
EHIBAH_BACKUP_PATH=/var/backups/ehibah
# Lokasi pg_dump bila tidak ada di PATH
PG_DUMP_BINARY=pg_dump
# Kata sandi akun demo (hanya DemoSeeder di lingkungan non-produksi)
DEMO_PASSWORD=
